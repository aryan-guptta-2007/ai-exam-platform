# App Settings
PROJECT_NAME="AI Exam Learning Platform"
ENV=development
API_V1_STR=/api/v1
SECRET_KEY=supersecretjwtkeyforlocaldevelopment1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=exam_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/exam_platform

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI / LLM Configuration
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
PRIMARY_LLM_PROVIDER=openai  # openai or gemini
FALLBACK_LLM_PROVIDER=gemini # openai or gemini

# Storage Configuration
STORAGE_PROVIDER=local       # local, s3, r2
STORAGE_LOCAL_PATH=./storage_uploads
S3_BUCKET_NAME=exam-platform-assets
AWS_ACCESS_KEY_ID=your-aws-access-key-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=us-east-1

# Feature Flags
ENABLE_DETAILED_COST_TRACKING=true
ENABLE_HALLUCINATION_VALIDATION=true
USE_HYBRID_RETRIEVAL=true
